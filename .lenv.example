# Main application settings. See docs/OPERATING_GUIDE.md and docs/CLI_REFERENCE.md.
# Copy to .lenv only if you do not already have one; uncomment the values you want.
# For the ready-to-use silent/manual-CAPTCHA profile instead:
#   bun run apply -- --configuration examples/operator.lenv
#
# Actual load order: ambient environment, then .lenv (overrides it), then an optional
# --configuration FILE (overrides .lenv); explicit CLI arguments win over all of these.
# The built-in defaults below apply when no configured value is present.
# --questions/--no-questions and --user-data-dir are CLI-only; there is no QUESTIONS
# or USER_DATA_DIR environment mapping in the current main CLI.
# .lenv is ignored by Git. Keep real credentials and personal settings there.

# Browser automation engine to use: playwright or puppeteer
# Built-in default: playwright
# ENGINE: "playwright"

# Vacancy search URL (default: suggested vacancies for the Russian CV, or the latest CV if unavailable)
# Built-in default: unset
# START_URL: "https://hh.ru/search/vacancy?resume=YOUR_RESUME_HASH&from=resumelist"

# Matching search: start at the target salary, lower by 50000 RUB after exhausting each tier, keep unspecified pay; exclude caps below half target
# Built-in default: true
# SALARY_LADDER: true

# Do not import logins from other browsers; wait for a manual login instead
# Built-in default: false
# MANUAL_LOGIN: false

# Only use logins from browser profiles whose name contains this text (e.g. "chrome Default")
# Built-in default: unset
# LOGIN_FROM: ""

# Keep the browser running after exit so the next run reuses it
# Built-in default: false
# KEEP_BROWSER_OPEN: false

# Minutes after which a kept-open, unused browser is closed
# Built-in default: 30
# BROWSER_IDLE_TIMEOUT: 30

# Remote debugging port of the automation browser
# Built-in default: 9322
# BROWSER_PORT: 9322

# Preset for a supervised run: --max-applications 1 and also confirm answers
# Built-in default: false
# TEST_MODE: false

# Steps to confirm on stdin, comma-separated: answers, cover-letter, send, popup, or none
# Built-in default: send
# CONFIRM: "send"

# Play a sound when attention is needed; disable sound while keeping visual alerts
# Built-in default: true
# NOTIFY_SOUND: false

# Questions without a saved answer: wait for the user to answer them, or skip the vacancy
# Built-in default: wait
# ON_MISSING_ANSWERS: "wait"

# Send a form with questions without asking when every question is a saved question word for word and autofill answered it with the saved answer; other forms are autofilled and wait for you
# Built-in default: true
# AUTO_SEND_EXACT_ANSWERS: true

# Select and verify the English CV for dollar pay or English questions; use Russian for Russian applications
# Built-in default: true
# AUTO_SELECT_RESUME_LANGUAGE: true

# When both answer variants exist, resolve a final-period conflict with or without the period; first saves keep their wording
# Built-in default: with
# ANSWER_FINAL_PERIOD: "with"

# Answer the viewed-but-not-applied vacancy survey with "Maybe I'll apply later"
# Built-in default: true
# AUTO_ANSWER_VIEWED_VACANCY: true

# How long the page has no requests before it counts as ready for the next step (browser-commander waits 30000 by default)
# Built-in default: 2000
# NETWORK_IDLE_MS: 2000

# Answer the chat hh.ru opens after an application (a recruiter bot's questions) before the next vacancy: perfect matches of saved answers are sent (with --auto-send-exact-answers), others wait for you in the panel
# Built-in default: true
# ANSWER_INSTANT_CHATS: true

# When a recruiter bot offers the answers given to it before («Используем эти ответы?»), choose «Да» when each is your saved answer and «Нет» when one differs; by default they are compared and you choose
# Built-in default: false
# AUTO_REUSE_ANSWERS: false

# Keep the automation browser to one tab: other tabs are closed when the run attaches, new ones as they open
# Built-in default: true
# SINGLE_TAB: true

# Prefill the captcha with the guesses of local Claude Code (Haiku) and Codex (latest Luna) for you to check and send
# Built-in default: true
# CAPTCHA_PREFILL: false

# Collect private vacancy descriptions, compare the résumé and add verified technology aliases; application entry is controlled separately
# Built-in default: true
# VACANCY_INSIGHTS: true

# Show and collect the vacancy page, then open its application directly; disable to return to search before opening the form
# Built-in default: true
# APPLY_FROM_VACANCY_PAGE: true

# Show the collected vacancy before its application (seconds, 0 disables the pause)
# Built-in default: 3
# VACANCY_PREVIEW_SECONDS: 3

# Cache full vacancy descriptions locally in Links Notation (never committed)
# Built-in default: true
# COLLECT_VACANCIES: true

# Print a separate technology coverage comparison with the résumé before each application
# Built-in default: true
# COMPARE_RESUME: true

# Add verified alternate spellings of existing résumé technologies to the résumé; never infer new experience
# Built-in default: true
# UPDATE_RESUME_ALIASES: true

# Private local vacancy cache directory
# Built-in default: ~/.hh-automation/vacancies
# VACANCY_CACHE_DIR: "~/.hh-automation/vacancies"

# With --captcha-prefill: send Haiku's reading of a captcha once; if hh.ru does not accept it, the captcha is only prefilled and waits for you
# Built-in default: true
# CAPTCHA_AUTO_SEND: false

# Skip vacancies that ask this question (or a part of it) for now; repeat for several. They are kept in data/deferred-questions.lino
# Built-in default: unset
# SKIP_QUESTIONS: "question fragment|another fragment"

# Stop after sending this many applications (0 = no limit)
# Built-in default: 0
# MAX_APPLICATIONS: 0

# Record browser diagnostics locally in ~/.hh-automation/traces (three-day retention by default)
# Built-in default: true
# TRACE: true

# Maximum age of local browser traces in days (positive; default 3)
# Built-in default: 3
# TRACE_RETENTION_DAYS: 3

# Seconds between opened vacancies, a fixed pace (a random extra of up to a quarter is added); 0, the default: adaptive pacing within 1-4 min, including jitter, with a bounded CAPTCHA hold
# Built-in default: 0
# JOB_APPLICATION_INTERVAL: 0

# Cover letter to send with every application (this or --message-file is required)
# Built-in default: unset
# MESSAGE: ""

# Path to a UTF-8 text file with the cover letter, e.g. data/cover-letter.txt
# Built-in default: unset
# MESSAGE_FILE: "data/cover-letter.txt"

# The English cover letter, used when the vacancy's questions are in English (default: <message-file>.en.txt when it exists)
# Built-in default: unset
# MESSAGE_FILE_EN: "data/cover-letter.en.txt"

# Enable verbose logging for debugging
# Built-in default: false
# VERBOSE: false

# Send forms with questions (popup or full form) unattended even when not every answer is the saved answer of the very same question (default: false for safety)
# Built-in default: false
# AUTO_SUBMIT_VACANCY_RESPONSE_FORM: false

# Skip vacancies that require additional questionnaire fields beyond the cover letter (kept in data/skipped-vacancies.lino)
# Built-in default: false
# IGNORE_VACANCIES_WITH_QUESTIONNAIRE: false

# Handle unread rejections in the inactive chat browser slot (port 9340); closed chats are read, open chats may get the configured reason request
# Built-in default: true
# CLEAR_REJECTIONS: true

# Ask once for the reason when a rejected application still allows replies, only in an inactive window without a draft
# Built-in default: true
# ASK_REJECTION_REASON: true

# Message sent once to an open rejection chat
# Built-in default: Здравствуйте, могу я узнать причину?
# REJECTION_REASON_REPLY: "Здравствуйте, могу я узнать причину?"

# Also answer unread chats alongside the application loop in the chat browser slot (port 9340), always after the rejections are cleared
# Built-in default: false
# PROCESS_CHATS: false

# How often the rejections are cleared and, with --process-chats, unread chats answered (minutes)
# Built-in default: 120
# CHATS_INTERVAL_MINUTES: 120

# Standalone notification switch: 0 turns off visual alerts as well.
# NOTIFY: 0

# Optional authenticated model discovery, not needed for ordinary application runs.
# bun run ai-status -- --probe makes an authenticated text request too.
# OXION_BASE_URL: "https://oxionai.com/v1"
# OXION_API_KEY: "your-private-key"
# OXION_MODEL: "MODEL_ID_FROM_YOUR_AUTHENTICATED_CATALOG"
